{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "import", "unicorn"],
  "jsPlugins": [
    "eslint-plugin-turbo",
    {
      "name": "elmera",
      "specifier": "@elmeragroup/internal/oxlint"
    },
    {
      "name": "anti-slop",
      "specifier": "@elmeragroup/internal/oxlint/anti-slop"
    },
    {
      "name": "tests",
      "specifier": "@elmeragroup/internal/oxlint/tests"
    },
    // Dogfoods the extraction contract on the e2e fixtures, loaded from source: the rule's module imports the
    // runtime's src through the `elmera-source` condition, which the lint script passes to Node.
    {
      "name": "elmera-intl",
      "specifier": "./packages/intl-tools/src/oxlint.ts"
    },
    // This workspace's own contracts (tooling/lint), loaded from source.
    {
      "name": "elmera-workspace",
      "specifier": "./tooling/lint/src/plugin.ts"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "rules": {
    "turbo/no-undeclared-env-vars": "error",
    "elmera/require-disable-reason": "error",
    "elmera-intl/extractable": "error",
    "elmera-workspace/export-prefixes": "error",
    // The test corpus and the e2e fixture apps' copies of it: extraction reads only a fixture's own files, so each
    // fixture keeps a real copy, and `pnpm lint:fix` rewrites it from the original.
    "elmera-workspace/file-copies": [
      "error",
      {
        "original": "packages/intl/test/fixtures.tsx",
        "copies": [
          "packages/intl-e2e/fixtures/next/components/corpus.tsx",
          "packages/intl-e2e/fixtures/start/src/components/corpus.tsx"
        ]
      }
    ],
    "elmera-workspace/global-names": "error",
    "elmera-workspace/import-boundaries": "error",
    "elmera-workspace/instance-names": "error",
    "elmera-workspace/public-surface": "error",
    "elmera-workspace/side-effect-free": "error",
    "elmera-workspace/vocabulary": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "typescript/no-misused-promises": [
      "error",
      {
        "checksVoidReturn": {
          "attributes": false
        }
      }
    ],
    "typescript/no-unnecessary-condition": [
      "error",
      {
        "allowConstantLoopConditions": true
      }
    ],
    "typescript/no-non-null-assertion": "error",
    "typescript/dot-notation": "error",
    "typescript/prefer-find": "error",
    "typescript/prefer-regexp-exec": "error",
    "typescript/prefer-string-starts-ends-with": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-empty-function": "error",
    "typescript/require-await": "error",
    "typescript/non-nullable-type-assertion-style": "error",
    "typescript/only-throw-error": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-unused-expressions": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],
    "typescript/no-misused-spread": "error",
    "typescript/require-array-sort-compare": "error",
    "no-constant-binary-expression": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-confusing-void-expression": ["error", { "ignoreArrowShorthand": true }],
    // A `default` branch is the exhaustiveness of a switch over a node's `type` among hundreds (oxc's ESTree).
    "typescript/switch-exhaustiveness-check": ["error", { "considerDefaultExhaustiveForUnions": true }],
    // `Array<T>` and `ReadonlyArray<T>`, as the code writes them.
    "typescript/array-type": ["error", { "default": "generic", "readonly": "generic" }],
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "curly": "error",
    // Deep readonly parameters: the parameters' types come from React, oxc's AST and Intl, which are not readonly
    // throughout, and immutability is held by `readonly` fields and `ReadonlyArray` where the code owns the type.
    "typescript/prefer-readonly-parameter-types": "off",
    // `_tag` is the discriminant of every tagged error and union, and `_` marks an unused parameter.
    "no-underscore-dangle": "off",
    // No arbitrary size limits: cohesion decides how long a module or function is.
    "max-lines": "off",
    "max-lines-per-function": "off",
    "max-classes-per-file": "off",
    "import/max-dependencies": "off",
    // A trailing comment labels the line it sits on (a test case, an IR tag).
    "no-inline-comments": "off",
    // Values are immutable: a map that builds a new object or array per element is the point.
    "oxc/no-map-spread": "off",
    // A narrowing assertion is allowed with its SAFETY reason, which anti-slop/require-safety-comment-for-type-assertion
    // requires.
    "typescript/no-unsafe-type-assertion": "off",
    // A `T | undefined` parameter takes an explicit `undefined` argument, and `return undefined` says a lookup missed.
    "unicorn/no-useless-undefined": "off",
    // TypeScript checks that every path of a function with a declared return type returns (TS2366), and sees an
    // exhaustive switch; this rule does not.
    "typescript/consistent-return": "off",
    // typescript/no-misused-promises catches the harmful case, a promise where void is expected; any other value
    // returned to a void callback is discarded harmlessly.
    "typescript/strict-void-return": "off",
    // The public `Format` type declares next-intl's overloaded methods (one signature per call form, each documenting
    // its parameters), which only method signatures express.
    "typescript/method-signature-style": "off",
    "typescript/unified-signatures": "off",
    // typescript/require-await is the type-aware version, which accepts an async function returning a promise.
    "require-await": "off",
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "import/no-cycle": "error",
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase",
        "ignore": ["^[a-z]{2}-[A-Z]{2}\\."]
      }
    ],
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-slop-comments": [
      "error",
      {
        "ticketPattern": "ELM-\\d+"
      }
    ],
    "anti-slop/no-narration-comments": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/.next/**",
    "**/.output/**",
    "**/.nitro/**",
    "**/.tanstack/**",
    "**/routeTree.gen.ts",
    "**/next-env.d.ts",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/.artifacts/**",
    "**/.cache/**",
    "**/node_modules/**",
    ".ref/**",
    ".scratch/**",
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**"
  ],
  "options": {
    "typeAware": true
  },
  "settings": {
    "react": {
      "version": "19"
    }
  },
  "overrides": [
    // The e2e fixture apps and the example apps (apps/*): React rules. The runtime's React code is held by its tests
    // and the conformance suite instead, which render keyless child arrays on purpose. The apps use the automatic JSX
    // runtime, and their <T> children are message sources written as an app writes them, apostrophes included.
    {
      "files": ["packages/intl-e2e/**/*.{ts,tsx}", "apps/**/*.{ts,tsx}"],
      "plugins": ["typescript", "oxc", "unicorn", "import", "react", "jsx-a11y"],
      "rules": {
        "react/react-in-jsx-scope": "off",
        "react/no-unescaped-entities": "off",
        "react/exhaustive-deps": "error",
        "react-hooks/rules-of-hooks": "error",
        "react-hooks/exhaustive-deps": "error",
        "react/no-unstable-nested-components": "error"
      }
    },
    // The Next example's root layout loads the app's global stylesheet (Tailwind and Fuse) for its effect, as Next has
    // a layout do. It is the one file that imports a stylesheet unassigned: the Start example's root binds its URL
    // (`styles.css?url`), so every other file keeps the rule whole.
    {
      "files": ["apps/next-example/app/layout.tsx"],
      "rules": {
        "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }]
      }
    },
    // @elmeragroup/intl and intl-tools are self-contained: they may import no other @elmeragroup package. Their source
    // implements the API the extraction contract restricts, and their tests break it on purpose.
    {
      "files": ["packages/intl/**", "packages/intl-tools/**"],
      "rules": {
        "elmera-intl/extractable": "off",
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@elmeragroup/*", "!@elmeragroup/intl", "!@elmeragroup/intl/*"],
                "message": "@elmeragroup/intl and intl-tools are self-contained: they may import no other @elmeragroup package, so consumers install nothing else of ours."
              }
            ]
          }
        ]
      }
    },
    // The runtime's floor is ES2022 (packages/intl/tsconfig.floor.json), and these rules' fixes are ES2023
    // (`toSorted`, `toReversed`, `findLast`): the runtime sorts or reverses a copy, and takes a last match with
    // `filter(...).at(-1)`. `typescript/prefer-find` still holds first-match lookups. The restricted globals and
    // properties are later built-ins the floor's type-check passes: @types/node (the shared `types: ["node"]`) and
    // Effect's declarations add `esnext.disposable` and `esnext.float16` to its program, which no `lib` setting
    // removes. Those declarations also mark native iterators disposable, so `elmera-workspace/no-using` rejects `using`.
    {
      "files": ["packages/intl/src/**"],
      "rules": {
        "unicorn/no-array-sort": "off",
        "unicorn/no-array-reverse": "off",
        "unicorn/prefer-array-find": "off",
        "elmera-workspace/no-using": "error",
        "no-restricted-globals": [
          "error",
          {
            "name": "DisposableStack",
            "message": "DisposableStack is not available on the runtime's ES2022 floor: run the cleanups from a callback list or try/finally."
          },
          {
            "name": "AsyncDisposableStack",
            "message": "AsyncDisposableStack is not available on the runtime's ES2022 floor: await the cleanups from a callback list or try/finally."
          },
          {
            "name": "SuppressedError",
            "message": "SuppressedError is not available on the runtime's ES2022 floor: use AggregateError, or an Error with `cause`."
          },
          {
            "name": "Float16Array",
            "message": "Float16Array is not available on the runtime's ES2022 floor: use Float32Array."
          }
        ],
        "no-restricted-properties": [
          "error",
          {
            "object": "Symbol",
            "property": "dispose",
            "message": "Symbol.dispose is not available on the runtime's ES2022 floor: give the resource a plain close method, called from try/finally."
          },
          {
            "object": "Symbol",
            "property": "asyncDispose",
            "message": "Symbol.asyncDispose is not available on the runtime's ES2022 floor: give the resource a plain async close method, awaited from try/finally."
          },
          {
            "object": "Math",
            "property": "f16round",
            "message": "Math.f16round is not available on the runtime's ES2022 floor: use Math.fround, or a Float32Array."
          }
        ]
      }
    },
    // oxc's ESTree types share one `type` ("Literal") across string, number, boolean, regexp and bigint literals,
    // so `typeof value` is the discriminant; ast-children walks the fields `visitorKeys` names, which TypeScript
    // cannot index, and checks each is a node.
    {
      "files": ["packages/intl-tools/src/extract-message.ts", "packages/intl-tools/src/ast-children.ts"],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    // ast-children takes the node's field values, which oxc types as unknown, and checks each is a node.
    {
      "files": ["packages/intl-tools/src/ast-children.ts"],
      "rules": {
        "anti-slop/no-unknown-parameters": "off"
      }
    },
    // The workspace plugin's JSON and AST boundary: workspace.ts parses package.json, public-surface.json and the
    // file-copies option, the manifest test's config-files.ts parses the JSON and YAML configs it checks, and ast.ts
    // tells string literals apart (oxc's one "Literal" type) and walks a node's unknown fields.
    {
      "files": [
        "tooling/lint/src/ast.ts",
        "tooling/lint/src/workspace.ts",
        "tooling/lint/test/workspace.test.ts",
        "tooling/lint/test/config-files.ts"
      ],
      "rules": {
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unsafe-dictionary-type": "off"
      }
    },
    // The `elmera-intl` bin's entry module: running at import is its job, and nothing imports it (the bin shim
    // spawns it), so no bundler can drop it.
    {
      "files": ["packages/intl-tools/src/cli.ts"],
      "rules": {
        "elmera-workspace/side-effect-free": "off"
      }
    },
    // The compiled catalog's IR uses the JS type as its tag (a literal is a plain string, `#` the number 0, structure
    // a tuple), so typeof is how a node is decoded; the compiler's dry-format proves every entry decodes.
    {
      "files": ["packages/intl/src/catalog.ts"],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    // The IR's tags are intl-messageformat's element TYPE values as plain numbers (catalog.ts's LITERAL = 0 and on), so
    // the codec, the formatter and the compiler's dry-format compare and build those numbers against the enum.
    {
      "files": [
        "packages/intl/src/catalog.ts",
        "packages/intl/src/icu.ts",
        "packages/intl-tools/src/compile.ts"
      ],
      "rules": {
        "typescript/no-unsafe-enum-comparison": "off",
        "typescript/no-unsafe-enum-assignment": "off"
      }
    },
    // A webpack/Turbopack loader receives its context as `this`.
    {
      "files": ["packages/intl-tools/src/po-loader.ts"],
      "rules": {
        "oxc/no-this-in-exported-function": "off"
      }
    },
    // The Effect example's API contract, which a client, the OpenAPI document and the tests import alone, and the one
    // module of its own it imports: they take only effect's schema and HTTP API modules, the runtime's `/effect`
    // subpath, as types only (`paths`; a value import would load the runtime), and each other, so the rule holds for
    // every module the contract reaches. Anything else, a Node module, effect's Node platform, srvx, the tools' catalog
    // loader, the locale negotiation, data or the server, is reported, re-exports included.
    {
      "files": ["apps/effect-example/src/api.ts", "apps/effect-example/src/invoice-number.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@elmeragroup/intl/effect",
                "allowTypeImports": true,
                "message": "The API contract takes the runtime's /effect subpath as types only: `import type`. A value import loads the runtime into every client; provide CurrentIntl in intl/intl-middleware.ts."
              }
            ],
            "patterns": [
              {
                "group": [
                  "*",
                  "!effect/ErrorReporter",
                  "!effect/Schema",
                  "!effect/http-api/HttpApi",
                  "!effect/http-api/HttpApiEndpoint",
                  "!effect/http-api/HttpApiGroup",
                  "!effect/http-api/HttpApiMiddleware",
                  "!@elmeragroup/intl/effect",
                  "!./invoice-number.ts"
                ],
                "message": "The API contract runs anywhere a client does: it imports only effect's schema and HTTP API modules, the runtime's /effect types and the invoice number. Wire Node, the listener, the locale negotiation, the catalog loader and data in server.ts or the intl middleware."
              }
            ]
          }
        ]
      }
    },
    // The release script's JSON boundary: package.json and `changeset status` output are read here, with no schema
    // library in the workspace scripts, so typeof is how their fields are checked before use.
    {
      "files": ["scripts/release.ts"],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    // Config boundary of the intl CLI: elmera-intl.json (project-config.ts) and the app's formats module
    // (project-formats.ts) are parsed here.
    {
      "files": ["packages/intl-tools/src/project-config.ts", "packages/intl-tools/src/project-formats.ts"],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    // <T> reads React children and element props, which have no static type: typeof is how text, numbers and
    // <Val>/<Plural> values are told apart from elements, and anything else is rejected. A message value is an
    // open primitive union (icu.ts): typeof picks the formatter a plain {x} renders it with. next-intl's formatter
    // overloads (format.ts) take a format name or options, a `now` or options, in one position: typeof tells them apart.
    {
      "files": [
        "packages/intl/src/resolve.tsx",
        "packages/intl/src/intl.ts",
        "packages/intl/src/icu.ts",
        "packages/intl/src/format.ts"
      ],
      "rules": {
        "anti-slop/no-runtime-typeof": "off"
      }
    },
    // Tests: the shared test rules. A test keeps a helper or component beside the case that uses it.
    {
      "files": ["**/*.{test,spec}{,-d}.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
      "rules": {
        "unicorn/consistent-function-scoping": "off",
        "tests/no-class-assertions": "error",
        "tests/no-fixed-delay": "error",
        "tests/no-geometry-assertions": "error",
        "tests/no-source-reading-tests": "error",
        "tests/no-test-retry": "error",
        "tests/no-wall-clock": "error"
      }
    },
    {
      "files": ["**/test/**/*.{ts,tsx,mts,mjs,js}", "**/tests/**/*.{ts,tsx,mts,mjs,js}"],
      "rules": {
        "tests/no-fixed-delay": "error",
        "tests/no-wall-clock": "error"
      }
    },
    {
      "files": ["**/vitest.config.*", "**/vitest.*.config.*", "**/playwright.config.*"],
      "rules": {
        "tests/no-test-retry": "error"
      }
    }
  ]
}
