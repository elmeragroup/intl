{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // Type-checks as a consumer does: `--customConditions null` drops the workspace's `elmera-source` condition, so it
    // reads the packages' built declarations. Lint still reads them through source.
    "type-check": {
      "dependsOn": ["^build"]
    }
  }
}
