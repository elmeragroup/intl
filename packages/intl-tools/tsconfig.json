{
  // Its Effect files are checked by the Effect language service (tooling/typescript/effect.json).
  "extends": [
    "@elmeragroup/typescript-config/react-library.json",
    "@elmeragroup/typescript-config/effect.json"
  ],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    // The oxlint plugin's import graph is loaded from source by Node's type stripping.
    "erasableSyntaxOnly": true,
    // The committed bin shim is plain JS (it must run before a build); type-check it like the source.
    "allowJs": true,
    "checkJs": true,
    // The message corpus lives with the runtime's tests (vitest.config.ts aliases it the same way).
    "paths": {
      "#corpus": ["../intl/test/fixtures.tsx"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        // Globs resolve against this file. The PO codec's round-trip property runs on effect/Arbitrary, which effect
        // 4.1 marks unstable; only the tests use it.
        "overrides": [
          { "include": ["test/**/*"], "options": { "allowedUnstableApis": ["effect/Arbitrary"] } }
        ]
      }
    ]
  },
  "include": ["bench", "bin", "src", "test", "vitest.config.ts", "tsdown.config.ts"],
  "exclude": ["dist", "node_modules"]
}
