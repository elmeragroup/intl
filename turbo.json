{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    // Reads source: type-aware rules and the plugins resolve the workspace packages through their `elmera-source`
    // export condition. Oxlint's import plugin does not: its resolver takes `@elmeragroup/intl/*` and
    // `@elmeragroup/intl-tools/*` to `dist` when it is built, and opens those files. So under turbo it waits for both
    // builds: a build running beside it deletes `dist` mid-read and fails it (#10). `pnpm lint` runs Oxlint directly and
    // needs no build: an unbuilt `dist` is skipped. Uncached: Oxlint reads every package's files (the e2e fixtures among
    // them), and turbo documents a task's default inputs only as its package's own files.
    "//#lint:oxlint": {
      "cache": false,
      "dependsOn": ["@elmeragroup/intl#build", "@elmeragroup/intl-tools#build"]
    },
    // The Effect lint pass: type-aware over the whole workspace and every module it imports, so no input list can name
    // what it reads. Uncached, as lint:oxlint is.
    "//#lint:effect": {
      "cache": false
    },
    "//#type-check:scripts": {
      "inputs": ["scripts/**", "tooling/typescript/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    // Strict env mode strips undeclared variables, so a dev server on a host without native file events (a container's
    // bind mount, WSL) polls only when chokidar's variables reach it: Vite's watcher and `intl()`'s watch read them.
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "passThroughEnv": ["CHOKIDAR_USEPOLLING", "CHOKIDAR_INTERVAL"]
    },
    // Has no script: it ties a package's hash to its dependencies' files, so a task that reads their source carries
    // their changes in its cache key without waiting for their tasks.
    "transit": {
      "dependsOn": ["^transit"]
    },
    // Source only, through the `elmera-source` condition (tooling/typescript/base.json), so it builds nothing; the
    // dependencies' source it reads is in its hash through transit.
    "type-check": {
      "dependsOn": ["^transit"]
    },
    "tcw": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"]
    },
    "test:run": {
      "dependsOn": ["^build"]
    },
    // The e2e fixture apps build on the workspace-linked packages and then on their packed archives,
    // so the builds are what is under test: never cached.
    "e2e": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": ["CI", "PLAYWRIGHT_BROWSERS_PATH", "INTL_FIXTURE_RUNTIME", "INTL_FIXTURE_SERVER"]
    },
    "bench": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "clean": {
      "cache": false
    },
    "ci:checks": {
      "dependsOn": ["^build", "//#lint:oxlint", "//#lint:effect", "//#type-check:scripts"]
    }
  }
}
